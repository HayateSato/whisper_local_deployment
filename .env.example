# Copy to .env and fill in. Loaded by the systemd unit (see whisper-web.service).
# DO NOT commit your real .env — it is gitignored.

# Required: shared password for the colleague to sign in.
# Default below is for testing — CHANGE for production.
WHISPER_PASSWORD=Transcribe123

# Required: random key used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WHISPER_SECRET_KEY=replace-with-64-hex-chars

# Optional: Whisper model size. large-v3 is best quality, needs ~4 GB VRAM.
# Options: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL_SIZE=large-v3

# Optional: timestamp annotation interval in seconds (0 disables timestamps).
WHISPER_TIMESTAMP_INTERVAL=300

# Optional: faster-whisper beam size.
WHISPER_BEAM_SIZE=5

# Optional: max upload size in MB. Cloudflare free plan caps at 100 MB
# per request even through a Tunnel — see DEPLOYMENT.md.
WHISPER_MAX_UPLOAD_MB=1024

# Optional: set to "false" if you are NOT using HTTPS at the edge
# (e.g. for local LAN testing). Cloudflare Tunnel always terminates HTTPS,
# so leave as "true" in production.
WHISPER_COOKIE_SECURE=true

# Optional: log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Docker / docker-compose only — ignored by the bare-metal systemd path.
# ----------------------------------------------------------------------

# Cloudflare Tunnel token. Required ONLY if you start the cloudflared
# sidecar via:  docker compose --profile tunnel up -d
# Generate it in: Cloudflare Zero Trust dashboard -> Networks -> Tunnels
# -> Create a tunnel (token method). Copy the long string after `--token`.
CLOUDFLARE_TUNNEL_TOKEN=

